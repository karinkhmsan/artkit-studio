# Copy this file to .env.local.
# The public address of your site. It goes into the share text. Set it after you deploy.
NEXT_PUBLIC_SITE_URL=https://your-site.example

# Google AdSense (optional). Leave empty to keep the ad areas as empty placeholders.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_SLOT_LEFT=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_RIGHT=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE=0000000000

# Show the "Support the creator" button and window? Only the exact value "true" turns it on.
NEXT_PUBLIC_DONATE_ENABLED=false

# "Support the creator" donate page (Easy Donate). Opens in a new tab. This default is used when empty.
NEXT_PUBLIC_DONATE_URL=

# Contact email shown on the Contact page (when you add it).
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Pexels photos for the timer. Get a free key at https://www.pexels.com/api/
# This key stays on the server. Do NOT put NEXT_PUBLIC_ in front of it.
PEXELS_API_KEY=
